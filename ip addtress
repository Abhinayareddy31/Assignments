public class DefangIPAddress {

    // Method 1: Using replace()
    public static String defangUsingReplace(String address) {
        return address.replace(".", "[.]");
    }

    // Method 2: Using StringBuilder
    public static String defangUsingStringBuilder(String address) {
        StringBuilder sb = new StringBuilder();

        for (char ch : address.toCharArray()) {
            if (ch == '.') {
                sb.append("[.]");
            } else {
                sb.append(ch);
            }
        }

        return sb.toString();
    }

    public static void main(String[] args) {
        String address = "192.168.1.1";

        System.out.println("Original IP Address : " + address);
        System.out.println("Using replace()     : " + defangUsingReplace(address));
        System.out.println("Using StringBuilder : " + defangUsingStringBuilder(address));
    }
}
