import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Take name as input
        System.out.print("Enter your name: ");
        String name = sc.nextLine();

        // Print greeting
        System.out.println("Hello, " + name + "! Welcome.");

        sc.close();
    }
}
