public class ValidNumber {

    // Method to check if the string is a valid number
    public static boolean isNumber(String s) {
        s = s.trim();

        boolean seenDigit = false;
        boolean seenDot = false;
        boolean seenExp = false;
        boolean digitAfterExp = true;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (Character.isDigit(c)) {
                seenDigit = true;
                digitAfterExp = true;
            } 
            else if (c == '.') {
                if (seenDot || seenExp)
                    return false;
                seenDot = true;
            } 
            else if (c == 'e' || c == 'E') {
                if (seenExp || !seenDigit)
                    return false;
                seenExp = true;
                digitAfterExp = false;
            } 
            else if (c == '+' || c == '-') {
                if (i != 0 && s.charAt(i - 1) != 'e' && s.charAt(i - 1) != 'E')
                    return false;
            } 
            else {
                return false;
            }
        }

        return seenDigit && digitAfterExp;
    }

    public static void main(String[] args) {

        String[] testCases = {
            "2", "0089", "-0.1", "+3.14", "4.", "-.9",
            "2e10", "-90E3", "3e+7", "53.5e93",
            "-123.456e789", "abc", "1a", "1e",
            "e3", "99e2.5", "--6", "-+3", "95a54e53"
        };

        for (String s : testCases) {
            System.out.println(s + " -> " + isNumber(s));
        }
    }
}
