import java.util.*;

public class SumTriangle {

    // Function to print sum triangle
    static void printTriangle(int[] arr, int n) {

        // Base condition
        if (n == 1) {
            System.out.println(arr[0]);
            return;
        }

        int[] temp = new int[n - 1];

        // Create next row by adding adjacent elements
        for (int i = 0; i < n - 1; i++) {
            temp[i] = arr[i] + arr[i + 1];
        }

        // Recursive call
        printTriangle(temp, n - 1);

        // Print current row after recursion
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }

        System.out.println();
    }


    public static void main(String[] args) {

        int[] arr = {1, 2, 3, 4, 5};

        printTriangle(arr, arr.length);
    }
}
